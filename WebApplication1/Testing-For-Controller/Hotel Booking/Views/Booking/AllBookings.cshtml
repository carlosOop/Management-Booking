@model IEnumerable<Hotel_Booking.Models.BookingViewModel> // This view expects a collection of BookingViewModel

@{
    ViewData["Title"] = "All Customer Bookings";
}

<div class="container mt-5">
    <h1>All Customer Bookings</h1>
    <hr />

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info" role="alert">
            No bookings found yet.
            <a asp-action="CustomerBooking" asp-controller="Booking" class="alert-link">Make a new booking</a>.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Id)</th>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.MobileNumber)</th>
                    <th>@Html.DisplayNameFor(model => model.Nationality)</th>
                    <th>@Html.DisplayNameFor(model => model.Gender)</th>
                    <th>@Html.DisplayNameFor(model => model.RoomType)</th>
                    <th>@Html.DisplayNameFor(model => model.RoomNumber)</th>
                    <th>@Html.DisplayNameFor(model => model.Price)</th>
                    <th>@Html.DisplayNameFor(model => model.CheckIn)</th>
                    <th>@Html.DisplayNameFor(model => model.CheckOut)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Id)</td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.MobileNumber)</td>
                        <td>@Html.DisplayFor(modelItem => item.Nationality)</td>
                        <td>@Html.DisplayFor(modelItem => item.Gender)</td>
                        <td>@Html.DisplayFor(modelItem => item.RoomType)</td>
                        <td>@Html.DisplayFor(modelItem => item.RoomNumber)</td>
                        <td>@Html.DisplayFor(modelItem => item.Price)</td>
                        <td>@item.CheckIn?.ToString("MM/dd/yyyy")</td>
                        <td>@item.CheckOut?.ToString("MM/dd/yyyy")</td>
                        <td>
                            <!-- You can add Edit/Delete links here if needed -->
                            @* <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id">Delete</a> *@
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-3">
        <a asp-action="CustomerBooking" asp-controller="Booking" class="btn btn-primary">Add New Booking</a>
    </div>
</div>